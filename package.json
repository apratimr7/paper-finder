{
  "name": "paper-finder",
  "version": "0.1.1",
  "description": "Find research papers from scraps of information and save them as metadata-only source notes in Obsidian.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test:live": "node esbuild.config.mjs test && node test/live.mjs",
    "test:pdf": "node -e \"require('esbuild').buildSync({entryPoints:['src/pdf.ts'],bundle:true,format:'cjs',platform:'node',outfile:'test/dist/pdf.cjs',alias:{obsidian:'./test/obsidian-stub.mjs'}})\" && node test/pdf.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test:note": "node esbuild.config.mjs test && node test/note.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/estree": "1.0.9"
  }
}
